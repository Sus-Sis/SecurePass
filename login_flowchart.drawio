        <mxCell id="conn_log_c5" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="log_step4" target="log_dec1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="conn_log_c_no" value="No" style="endArrow=classic;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="log_dec1" target="log_fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_log_c_yes" value="Yes" style="endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="log_dec1" target="log_mfa_check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="conn_mfa_yes" value="Yes" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="log_mfa_check" target="log_mfa_prompt">
