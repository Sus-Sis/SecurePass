        <mxCell id="conn_log_c4" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="log_step3" target="log_step4">
          <mxGeometry relative="1" as="geometry" />
