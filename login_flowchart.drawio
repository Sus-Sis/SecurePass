<mxfile host="app.diagrams.net" modified="2026-06-10T00:00:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="log_diag" name="Login Flow">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="title" value="SecurePass - Login &amp; Authentication Flow" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="225" y="30" width="400" height="40" as="geometry" />
        </mxCell>

        <mxCell id="log_start" value="Start Login" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="log_step1" value="Input Email &amp; Master Password" style="html=1;shape=mxgraph.flowchart.manual_input;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="350" y="180" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="log_step2" value="Fetch user Salt from /api/auth/prelogin&#xa;(Returns dynamic fake salt if email not found)" style="html=1;shape=mxgraph.flowchart.document;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="270" width="210" height="70" as="geometry" />
        </mxCell>

        <mxCell id="log_step3" value="Derive Master Key (MK) via PBKDF2&#xa;&amp; compute Verifier = SHA256(MK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="335" y="370" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="log_step4" value="POST verifier to /api/auth/login&#xa;&amp; check rate limit &amp; lock status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="335" y="460" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="log_dec1" value="Credentials&#xa;Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="370" y="550" width="110" height="80" as="geometry" />
        </mxCell>

        <mxCell id="log_fail" value="Increment failures.&#xa;If &gt;=10 failures, lock&#xa;account for 15 mins.&#xa;Return 401/423 Error." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="120" y="560" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="log_mfa_check" value="MFA Required?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="540" y="550" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="log_mfa_prompt" value="Prompt user for TOTP code&#xa;&amp; verify on server" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="525" y="670" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="log_success" value="Generate Session Token (JWT),&#xa;fetch encrypted vault, and&#xa;decrypt vault client-side using MK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="720" y="550" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="log_end" value="End (Dashboard Loaded)" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="745" y="670" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Connections -->
        <mxCell id="conn_log_c1" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="log_start" target="log_step1">
          <mxGeometry relative="1" as="geometry" />
