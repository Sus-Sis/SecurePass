        <mxCell id="conn_mfa_verify_success" value="Valid" style="endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="log_mfa_prompt" target="log_success">
          <mxGeometry relative="1" as="geometry" />
